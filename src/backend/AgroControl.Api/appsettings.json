{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=agrocontrol;Username=agrocontrol;Password=agrocontrol_dev"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://tauri.localhost"
    ]
  },
  "Jwt": {
    "Issuer": "AgroControl",
    "Audience": "AgroControl.Web",
    "Key": "",
    "ExpirationMinutes": 60
  },
  "RemoteSensing": {
    "Stac": {
      "TimeoutSeconds": 20,
      "Providers": {
        "earth-search": {
          "DisplayName": "Earth Search (Element 84)",
          "BaseUrl": "https://earth-search.aws.element84.com/v1",
          "Enabled": true,
          "Collections": [
            "sentinel-2-l2a",
            "landsat-c2-l2"
          ]
        }
      }
    }
  },
  "Observability": {
    "Enabled": false,
    "ServiceName": "AgroControl.Api"
  }
}
