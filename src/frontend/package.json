{
  "name": "@agrocontrol/web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:icons": "npx --yes @tauri-apps/cli@2 icon public/icons/agrocontrol.svg",
    "desktop:dev": "npm run desktop:icons && npx --yes @tauri-apps/cli@2 dev",
    "desktop:build": "npm run desktop:icons && npx --yes @tauri-apps/cli@2 build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
